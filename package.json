{
  "name": "carescript-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "install:all": "npm install && npm --prefix frontend install",
    "dev": "node scripts/dev-all.mjs",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "node scripts/dev-backend.mjs",
    "build": "npm --prefix frontend run build",
    "test": "node tests/run-tests.mjs",
    "test:live": "node --test --env-file=.env.local tests/integration/backend-security.test.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "lint": "node scripts/run-lint.mjs",
    "check": "npm --prefix frontend run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.15.0",
    "playwright-core": "^1.51.1",
    "typescript-eslint": "^8.26.0"
  }
}
