# Public Supabase client configuration. Never put server secrets in VITE_*.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Server-only Gemini secret: configure in Supabase Dashboard -> Edge Functions -> Secrets.
# GEMINI_API_KEY=your-google-gemini-api-key
# GEMINI_MODEL=gemini-3.8-flash

# Optional dedicated accounts for live RLS and AI integration checks.
# SUPABASE_TEST_USER_A_EMAIL=
# SUPABASE_TEST_USER_A_PASSWORD=
# SUPABASE_TEST_USER_B_EMAIL=
# SUPABASE_TEST_USER_B_PASSWORD=
