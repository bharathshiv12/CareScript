# ==============================================================================
# CareScript Frontend Client Environment Variables (Public / Browser-Exposed)
# Copy this file to .env.local and fill in your project values.
# NEVER put GEMINI_API_KEY or SUPABASE_SERVICE_ROLE_KEY in VITE_* variables!
# ==============================================================================

# Firebase Web Client Configuration
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# Supabase Client Configuration (Publishable / Anon Key only)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# ==============================================================================
# Server-Side Secrets (Configure ONLY in Supabase Edge Function Secrets)
# Do NOT prefix with VITE_
#   npx supabase secrets set GEMINI_API_KEY=...
# ==============================================================================
# GEMINI_API_KEY=your-google-gemini-api-key
# GEMINI_MODEL=gemini-3.8-flash
