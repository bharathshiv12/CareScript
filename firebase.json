{
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "CareScript",
        "authorizedRedirectUris": [
          "https://carescript.firebaseapp.com/__/auth/handler",
          "http://localhost:5173"
        ]
      }
    }
  },
  "functions": [
    {
      "source": "backend/firebase-functions",
      "codebase": "default"
    }
  ],
  "emulators": {
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  }
}